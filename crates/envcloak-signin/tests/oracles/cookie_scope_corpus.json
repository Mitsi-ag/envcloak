{
  "schema": 1,
  "scope": "ASCII HTTP host/domain/path; expected delivery from hand-labelled cases and actual Chromium receipts",
  "scenarios": [
    {
      "id": "host-only",
      "domain_attribute": null,
      "path_attribute": "/",
      "issue_path": "/issue",
      "scope": {
        "domain": "acme.localhost",
        "host_only": true,
        "path": "/"
      },
      "probes": [
        {
          "host": "acme.localhost",
          "port": 0,
          "path": "/",
          "expected": true
        },
        {
          "host": "acme.localhost",
          "port": 1,
          "path": "/",
          "expected": true
        },
        {
          "host": "child.acme.localhost",
          "port": 0,
          "path": "/",
          "expected": false
        },
        {
          "host": "otheracme.localhost",
          "port": 0,
          "path": "/",
          "expected": false
        },
        {
          "host": "acme.localhost.other.localhost",
          "port": 0,
          "path": "/",
          "expected": false
        },
        {
          "host": "idp.localhost",
          "port": 0,
          "path": "/",
          "expected": false
        }
      ]
    },
