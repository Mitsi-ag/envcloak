#!/usr/bin/env python3
"""Print NSPasteboard type UTIs (and optional changeCount) without reading pasteboard content.

Used by M3-21 QA step A10 (gate g6) to verify that `org.nspasteboard.ConcealedType`
and `org.nspasteboard.TransientType` are present on the pasteboard without ever
calling `stringForType:` or `dataForType:`.
"""
import argparse
import ctypes
import ctypes.util
import json
import sys


def load_pasteboard_types(pasteboard_name=None):
    objc_path = ctypes.util.find_library("objc")
    appkit_path = "/System/Library/Frameworks/AppKit.framework/AppKit"
    foundation_path = "/System/Library/Frameworks/Foundation.framework/Foundation"
    if not objc_path:
        raise RuntimeError("libobjc not found")
    objc = ctypes.cdll.LoadLibrary(objc_path)
    ctypes.cdll.LoadLibrary(foundation_path)
    ctypes.cdll.LoadLibrary(appkit_path)

    objc.objc_getClass.restype = ctypes.c_void_p
    objc.objc_getClass.argtypes = [ctypes.c_char_p]
    objc.sel_registerName.restype = ctypes.c_void_p
    objc.sel_registerName.argtypes = [ctypes.c_char_p]

    def sel(name):
        return objc.sel_registerName(name.encode("utf-8"))

    msg_ptr = ctypes.CFUNCTYPE(ctypes.c_void_p, ctypes.c_void_p, ctypes.c_void_p)(
        ("objc_msgSend", objc)
    )
    msg_ptr_ptr = ctypes.CFUNCTYPE(
        ctypes.c_void_p, ctypes.c_void_p, ctypes.c_void_p, ctypes.c_void_p
    )(("objc_msgSend", objc))
    msg_ptr_cstr = ctypes.CFUNCTYPE(
        ctypes.c_void_p, ctypes.c_void_p, ctypes.c_void_p, ctypes.c_char_p
    )(("objc_msgSend", objc))
    msg_long = ctypes.CFUNCTYPE(ctypes.c_long, ctypes.c_void_p, ctypes.c_void_p)(
        ("objc_msgSend", objc)
    )
    msg_ulong = ctypes.CFUNCTYPE(ctypes.c_ulong, ctypes.c_void_p, ctypes.c_void_p)(
        ("objc_msgSend", objc)
    )
    msg_idx = ctypes.CFUNCTYPE(
        ctypes.c_void_p, ctypes.c_void_p, ctypes.c_void_p, ctypes.c_ulong
    )(("objc_msgSend", objc))
    msg_cstr = ctypes.CFUNCTYPE(ctypes.c_char_p, ctypes.c_void_p, ctypes.c_void_p)(
        ("objc_msgSend", objc)
    )

    ns_string_cls = objc.objc_getClass(b"NSString")
    ns_pasteboard_cls = objc.objc_getClass(b"NSPasteboard")
    if pasteboard_name:
        ns_name = msg_ptr_cstr(
            ns_string_cls, sel("stringWithUTF8String:"), pasteboard_name.encode("utf-8")
        )
        pb = msg_ptr_ptr(ns_pasteboard_cls, sel("pasteboardWithName:"), ns_name)
    else:
        pb = msg_ptr(ns_pasteboard_cls, sel("generalPasteboard"))

    if not pb:
        return 0, []

    change_count = int(msg_long(pb, sel("changeCount")))
    types_array = msg_ptr(pb, sel("types"))
    if not types_array:
        return change_count, []

    count = int(msg_ulong(types_array, sel("count")))
    out = []
    for i in range(count):
        item = msg_idx(types_array, sel("objectAtIndex:"), i)
        if item:
            raw = msg_cstr(item, sel("UTF8String"))
            if raw:
                out.append(raw.decode("utf-8", errors="replace"))
    return change_count, out


def main():
    parser = argparse.ArgumentParser(
        description="List NSPasteboard type identifiers without reading content."
    )
    parser.add_argument(
        "--pasteboard",
        default=None,
        help="Optional NSPasteboard name (default: general pasteboard).",
    )
    parser.add_argument(
        "--with-change-count",
        action="store_true",
        help="Include change_count=<N> header line.",
    )
    parser.add_argument(
        "--json",
        action="store_true",
        help="Emit JSON object with change_count and types.",
    )
    args = parser.parse_args()
    change_count, types = load_pasteboard_types(args.pasteboard)
    if args.json:
        print(json.dumps({"change_count": change_count, "types": types}))
        return 0
    if args.with_change_count:
        print(f"change_count={change_count}")
    for t in types:
        print(t)
    return 0


if __name__ == "__main__":
    sys.exit(main())
