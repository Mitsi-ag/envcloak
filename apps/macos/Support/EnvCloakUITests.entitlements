<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Xcode sandboxes UI runners by default. Their CLI and sweep children
	     need the private fixture HOME and the external daemon's Unix socket. -->
	<key>com.apple.security.app-sandbox</key>
	<false/>
</dict>
</plist>
