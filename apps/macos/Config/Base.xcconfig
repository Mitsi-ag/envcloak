// Every target and configuration of EnvCloak.xcodeproj (docs/APP.md
// "Toolchain and floor"): SwiftUI, Swift 6 with strict concurrency and
// warnings as errors, macOS 26 or later, the hardened runtime everywhere.
//
// Signing comes last: ad hoc by default (tier 1, D3-05). A build for
// another tier passes `-xcconfig Config/Signing-<Tier>.xcconfig` to
// xcodebuild, which takes precedence over this file; scripts/macos/
// build-app.sh does that and signs the bundle itself.

SDKROOT = macosx
SUPPORTED_PLATFORMS = macosx
MACOSX_DEPLOYMENT_TARGET = 26.0
SWIFT_VERSION = 6.0
SWIFT_STRICT_CONCURRENCY = complete
SWIFT_TREAT_WARNINGS_AS_ERRORS = YES
GCC_TREAT_WARNINGS_AS_ERRORS = YES
SWIFT_EMIT_LOC_STRINGS = YES
DEVELOPMENT_LANGUAGE = en

// The version the bundle reports. build-app.sh passes the workspace
// version from Cargo.toml, and its layout check refuses a bundle whose
// version differs from the bundled CLI's.
MARKETING_VERSION = 0.1.0
CURRENT_PROJECT_VERSION = 1

// Hardened runtime on every executable; release builds get no base
// entitlements from Xcode (no com.apple.security.get-task-allow), and
// scripts/macos/sign-check.sh refuses any artifact that carries it.
ENABLE_HARDENED_RUNTIME = YES
CODE_SIGN_INJECT_BASE_ENTITLEMENTS[config=Release] = NO
ENABLE_APP_SANDBOX = NO
ENABLE_USER_SCRIPT_SANDBOXING = YES

// Colours come only from EnvCloakDesign's tokens: no generated asset
// symbols that would let a view name a catalog colour directly.
ASSETCATALOG_COMPILER_GENERATE_SWIFT_ASSET_SYMBOL_EXTENSIONS = NO
ASSETCATALOG_COMPILER_GENERATE_ASSET_SYMBOLS = NO

ALWAYS_SEARCH_USER_PATHS = NO
CLANG_ENABLE_MODULES = YES
COMBINE_HIDPI_IMAGES = YES
COPY_PHASE_STRIP = NO
DEAD_CODE_STRIPPING = YES
ENABLE_STRICT_OBJC_MSGSEND = YES
GCC_NO_COMMON_BLOCKS = YES

ONLY_ACTIVE_ARCH[config=Debug] = YES
ENABLE_TESTABILITY[config=Debug] = YES
SWIFT_OPTIMIZATION_LEVEL[config=Debug] = -Onone
SWIFT_ACTIVE_COMPILATION_CONDITIONS[config=Debug] = DEBUG
DEBUG_INFORMATION_FORMAT[config=Debug] = dwarf
SWIFT_OPTIMIZATION_LEVEL[config=Release] = -O
SWIFT_COMPILATION_MODE[config=Release] = wholemodule
DEBUG_INFORMATION_FORMAT[config=Release] = dwarf-with-dsym
VALIDATE_PRODUCT[config=Release] = YES

#include "Signing-Adhoc.xcconfig"
